{
  "manifest_version": 3,
  "name": "Alibaba Supplier Compare",
  "version": "1.0.0",
  "description": "Compare Alibaba suppliers side by side: tiered prices at your target quantity, MOQ, certifications and Trade Assurance. Exports to Sheets.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Add this product to the comparison",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "src/panel/sidepanel.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
